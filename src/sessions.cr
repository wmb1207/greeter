require "./account"
require "./failure"
require "./logger"
require "./platform"
require "./session_plan"
require "./session_tracker"

# Session discovery (.desktop files) and turning a menu choice into a
# SessionPlan::Launch.  Builders only look things up on disk; Supervisor
# runs the result.
module Sessions
  enum SessionType
    X11
    Wayland
  end

  record DesktopSession, name : String, exec : String, session_type : SessionType do
    def label : String
      suffix = case session_type
               in .x11?     then "X11"
               in .wayland? then "Wayland"
               end
      "#{name} (#{suffix})"
    end
  end

  def self.available_sessions(xsession_dirs : Array(String), wayland_session_dirs : Array(String)) : Array(DesktopSession)
    candidates = desktop_files(xsession_dirs, SessionType::X11) +
                 desktop_files(wayland_session_dirs, SessionType::Wayland)

    # A file reachable from several directories is listed once.
    candidates.uniq(&.[0])
      .compact_map { |(path, type)| read_desktop_file(path, type) }
      .sort_by! { |session| {session.name, session.session_type.to_s} }
  end

  # Parse the [Desktop Entry] group of a .desktop file.  Returns nil unless
  # both Name= and Exec= are present.
  def self.parse_desktop_entry(content : String, session_type : SessionType) : DesktopSession?
    name = nil
    exec = nil
    in_entry = false

    content.each_line do |raw|
      line = raw.strip
      if line.starts_with?('[')
        in_entry = line == "[Desktop Entry]"
      elsif in_entry
        name ||= line.lchop?("Name=")
        # Strip .desktop field codes (%F, %u, etc.) — unused in session files
        exec ||= line.lchop?("Exec=").try(&.gsub(/%[A-Za-z]/, "").strip)
      end
    end

    name && exec ? DesktopSession.new(name, exec, session_type) : nil
  end

  private def self.desktop_files(dirs : Array(String), session_type : SessionType) : Array({String, SessionType})
    dirs.flat_map do |dir|
      Dir.glob("#{dir}/*.desktop").sort.map { |path| {path, session_type} }
    end
  end

  private def self.read_desktop_file(path : String, session_type : SessionType) : DesktopSession?
    parse_desktop_entry(File.read(path), session_type)
  rescue ex
    Logger.warn("sessions.desktop_file_unreadable", "Ignoring unreadable session file", {path: path, error: ex.message})
    nil
  end

  # ═══════════════════════════════════════════════════════════════════════════════
  # Launch builders
  # ═══════════════════════════════════════════════════════════════════════════════

  # X11 on its own VT from the SessionTracker pool; display :N = vt - FIRST_VT.
  # Prefers ~/.xsession (generated by home-manager) so user-session systemd
  # targets (hm-graphical-session.target) start; falls back to the .desktop
  # Exec= command.
  def self.x11(account : Account, wm_exec : String, vt : Int32, seat : String) : SessionPlan::Launch | Failure
    startx = find_command("startx", account)
    return missing_command("x11", "startx", account) if startx.nil?

    xsession = "#{account.home}/.xsession"
    client = File::Info.executable?(xsession) ? xsession : wm_exec
    tty = Platform.tty_path(vt)

    SessionPlan::Launch.new(
      kind: SessionPlan::Kind::X11,
      account: account,
      command: startx,
      args: SessionPlan.startx_args(client, vt, vt - SessionTracker::FIRST_VT),
      env: SessionPlan.graphical_env(account, "x11", vt, seat),
      tty: tty,
      pam: SessionPlan::PamSession.new(tty, "x11", seat, vt),
      target: wm_exec
    )
  end

  def self.wayland(account : Account, session_exec : String, vt : Int32, seat : String) : SessionPlan::Launch | Failure
    args = SessionPlan.exec_args(session_exec)
    return Failure.new("Greeter: empty Wayland session command") if args.empty?

    command = find_command(args.first, account)
    return missing_command("wayland", args.first, account) if command.nil?

    tty = Platform.tty_path(vt)
    SessionPlan::Launch.new(
      kind: SessionPlan::Kind::Wayland,
      account: account,
      command: command,
      args: args[1..],
      env: SessionPlan.graphical_env(account, "wayland", vt, seat),
      tty: tty,
      pam: SessionPlan::PamSession.new(tty, "wayland", seat, vt),
      target: session_exec
    )
  end

  # Runs on the greeter's own terminal; no PAM session is opened.
  def self.ssh(account : Account, host : String) : SessionPlan::Launch | Failure
    command = find_command("ssh", account)
    return missing_command("ssh", "ssh", account) if command.nil?

    SessionPlan::Launch.new(
      kind: SessionPlan::Kind::Ssh,
      account: account,
      command: command,
      args: ["-l", account.name, host],
      env: SessionPlan.ssh_env(account, ENV["TERM"]? || Platform.term),
      tty: nil,
      pam: nil,
      target: host
    )
  end

  # Runs moonlight-qt directly on the KMS/DRM framebuffer (SDL_VIDEODRIVER=kmsdrm)
  # on the greeter's terminal — no X server needed.  A PAM session is still
  # opened so logind registers the session and creates /run/user/<uid>
  # (needed for PipeWire audio).
  def self.moonlight(account : Account, host : String, tty : String, vt : Int32, seat : String) : SessionPlan::Launch | Failure
    command = find_command("moonlight", account) || find_command("moonlight-qt", account)
    return missing_command("moonlight", "moonlight", account) if command.nil?

    SessionPlan::Launch.new(
      kind: SessionPlan::Kind::Moonlight,
      account: account,
      command: command,
      args: ["stream", host, "Desktop"],
      env: SessionPlan.moonlight_env(account, vt, seat),
      tty: tty,
      pam: SessionPlan::PamSession.new(tty, "x11", seat, vt),
      target: host
    )
  end

  private def self.find_command(name : String, account : Account) : String?
    Process.find_executable(name, SessionPlan.session_path(account), account.home)
  end

  private def self.missing_command(event : String, name : String, account : Account) : Failure
    Logger.error("session.#{event}.command_missing", "Command not found in session PATH", {username: account.name, uid: account.uid, command: name})
    Failure.new("Greeter: #{name} not found in session PATH")
  end
end
